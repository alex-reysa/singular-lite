    "implementer-core": {
      "startup": "lazy",
      "required": [
        "filesystem",
        "git",
        "schemas",
        "runner-contract",
        "provider-executable"
      ],
      "optional": []
    },
    "audit-core": {
      "startup": "lazy",
      "required": [
        "filesystem",
        "git",
        "schemas",
        "runner-contract",
        "provider-executable"
      ],
      "optional": []
    },
    "decider-core": {
      "startup": "lazy",
      "required": [
        "filesystem",
        "git",
        "schemas",
        "runner-contract",
        "provider-executable"
      ],
      "optional": []
    },
    "integrator-core": {
      "startup": "lazy",
      "required": [
        "filesystem",
        "git",
        "schemas",
        "runner-contract",
        "provider-executable"
      ],
      "optional": []
    },
    "supervisor-core": {
      "startup": "lazy",
      "required": [
        "filesystem",
        "git",
        "schemas",
        "runner-contract",
        "provider-executable"
      ],
      "optional": []
    }
  },
  "roleProfiles": {
    "planner": "planner-core",
    "critic": "audit-core",
    "implementer": "implementer-core",
    "auditor": "audit-core",
    "decider": "decider-core",
    "integrator": "integrator-core",
    "supervisor": "supervisor-core",
    "assistant": "supervisor-core"
  },
  "evidence": {
    "maxComposedBytes": 262144,
    "maxExcerptBytes": 2048,
    "retrievalBudgetBytes": 262144,
    "auditInputTokenCanary": 100000
  },
  "bootstrap": {
    "required": false,
    "command": "",
    "commands": [],
    "lockfiles": [],
    "sharedStoreRoots": [],
    "sharedLinks": []
  },
  "resources": {
    "diskReserveBytes": 2147483648,
    "estimatedWorktreeBytes": 268435456,
    "maxConcurrent": 3
  },
  "controlState": {
    "commitIntervalSeconds": 300
  },
  "legacyCompatibility": {
    "unboundWaivers": false
  },
  "identity": {
    "l0": {
      "name": "singular L0",
      "email": "l0@singular.local"
    },
    "l1": {
      "name": "singular L1",
      "email": "l1@singular.local"
    }
  },
  "env": {
    "SINGULAR_MAX_CONCURRENT": "3",
    "SINGULAR_MAX_DISPATCH": "3",
    "SINGULAR_ENABLE_L1_PARALLEL": "1",
    "SINGULAR_CLAUDE_MODEL": "claude-opus-4-8",
    "SINGULAR_CLAUDE_L2_MODEL": "claude-opus-4-8",
    "SINGULAR_CLAUDE_L1_MODEL": "claude-opus-4-8",
    "SINGULAR_CLAUDE_PLANNER_MODEL": "claude-opus-4-8",
    "SINGULAR_CLAUDE_AUDITOR_MODEL": "claude-opus-4-8",
    "SINGULAR_CLAUDE_DECIDER_MODEL": "claude-opus-4-8",
    "SINGULAR_PLANNER_SESSION": "1",
    "SINGULAR_PLAN_CRITIQUE": "1",
    "SINGULAR_PAIRED_AUDIT_PCT": "25",
    "SINGULAR_L2_SLICE_BUDGET": "3",
    "SINGULAR_CODEX_MODEL": "gpt-5.6-sol",
    "SINGULAR_CODEX_L1_REASONING_EFFORT": "high",
    "SINGULAR_CODEX_L2_REASONING_EFFORT": "medium",
    "SINGULAR_CODEX_PLANNER_REASONING_EFFORT": "high",
    "SINGULAR_CODEX_AUDITOR_REASONING_EFFORT": "high",
    "SINGULAR_CODEX_CRITIC_REASONING_EFFORT": "high",
    "SINGULAR_CODEX_DECIDER_REASONING_EFFORT": "high",
    "SINGULAR_CODEX_READONLY_REASONING_EFFORT": "high",
    "SINGULAR_CTX_PACKET": "1",
    "SINGULAR_CTX_ROUTING": "1",
    "SINGULAR_CTX_ARTIFACT_SCAN": "1",
    "SINGULAR_SUPERVISOR_INTERVAL_MIN": "15"
  }
