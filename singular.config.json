{
  "schemaVersion": "v2",
  "engineVersion": "0.21.0",
  "targetBranch": "agent/integration",
  "gateCommand": "SINGULAR_TEST_JOBS=4 bash tests/run.sh",
  "runner": "claude-run.sh",
  "areaPrefix": "engine/",
  "areas": {
    "foundation": [
      "engine/",
      "tests/",
      "cli/"
    ],
    "session": [
      "engine/",
      "tests/"
    ],
    "plancritic": [
      "engine/",
      "tests/",
      "schemas/",
      "templates/prompts/"
    ],
    "packets": [
      "engine/",
      "tests/",
      "schemas/",
      "templates/prompts/"
    ],
    "routing": [
      "engine/",
      "tests/"
    ],
    "graph": [
      "engine/",
      "tests/",
      "schemas/",
      "cli/"
    ],
    "eval": [
      "docs/",
      "README.md",
      "CHANGELOG.md",
      "VERSION",
      ".singular-version",
      "singular.config.json",
      "templates/singular.config.json"
    ]
  },
  "proofLayers": [],
  "proofGrandfather": [],
  "prewarm": "",
