#!/usr/bin/env bash
# singular — machine-level launcher for the orchestration engine.
#
# Resolves the engine version pinned by the current repo, points the engine at
# the current repo (SINGULAR_ROOT), loads that repo's config, and execs the engine
# entrypoint. Same command works in every repo; improvements propagate by
# bumping the pinned version (`singular update`).
set -euo pipefail

# Interpreter guard — a verbatim embedded copy of engine/bash-guard.sh.
# *** keep in sync with engine/bash-guard.sh ***
#
# Embedded, not sourced: the CLI must be able to fix its own interpreter
# before it can resolve an engine home (that resolution itself needs Bash >=
# 4), so it cannot depend on a file it has not located yet. SINGULAR_BASH_BIN
# stays bootstrap-only — available before repo configuration is loaded, and
# honored by re-exec'ing exactly once so every CLI command and engine
# entrypoint starts under the requested interpreter without changing PATH (and
# therefore without changing provider resolution). A bare `/bin/bash singular`
# on macOS Bash 3.2 with no pin set is the case the fallback probes close.
if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 || -n "${SINGULAR_BASH_BIN:-}" ]]; then

  # Terminal diagnosis: fixed block, optional one-line detail, exit 2.
  singular_bash_guard__fail() {
    {
      echo "SINGULAR_BASH_UNSUPPORTED"
      echo "Found: ${BASH:-bash} ${BASH_VERSION%%(*}"
      echo "Required: Bash >= 4"
      echo "Recovery: brew install bash && SINGULAR_BASH_BIN=/opt/homebrew/bin/bash singular setup"
      if [[ -n "${1:-}" ]]; then echo "  detail: $1"; fi
    } >&2
    exit 2
  }

  # An executable bit is not proof of a version: ask the candidate itself.
  singular_bash_guard__probe() {
    [[ -n "${1:-}" && "$1" == /* && -x "$1" ]] || return 1
    "$1" -c '[[ "${BASH_VERSINFO[0]}" -ge 4 ]]' >/dev/null 2>&1 || return 1
    return 0
  }

  # (2) Loop guard: we already re-exec'd and are still < 4. Never exec again.
  if [[ "${SINGULAR_BASH_BOOTSTRAPPED:-0}" == "1" && "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
    singular_bash_guard__fail "re-exec target did not provide Bash >= 4: ${SINGULAR_BASH_BIN:-<unset>}"
  fi

  # (3) Explicit pin wins over the running interpreter, exactly once. PATH is
  # deliberately not modified: provider resolution must not shift.
  if [[ -n "${SINGULAR_BASH_BIN:-}" && "${SINGULAR_BASH_BOOTSTRAPPED:-0}" != "1" ]]; then
    if [[ "$SINGULAR_BASH_BIN" != /* || ! -x "$SINGULAR_BASH_BIN" ]]; then
      singular_bash_guard__fail "SINGULAR_BASH_BIN must be an absolute executable path: $SINGULAR_BASH_BIN"
    fi
    if ! singular_bash_guard__probe "$SINGULAR_BASH_BIN"; then
      singular_bash_guard__fail "SINGULAR_BASH_BIN must provide Bash >= 4: $SINGULAR_BASH_BIN"
    fi
    export SINGULAR_BASH_BOOTSTRAPPED=1
    exec "$SINGULAR_BASH_BIN" "$0" "$@"
  fi

  # (4) No pin and still < 4: the bare-invocation case. Probe before exec so a
  # broken candidate cannot swallow the diagnosis.
  if [[ "${BASH_VERSINFO[0]:-0}" -lt 4 ]]; then
    singular_bash_guard__path="$(command -v bash 2>/dev/null || true)"
    if [[ "$singular_bash_guard__path" == "${BASH:-}" ]]; then singular_bash_guard__path=""; fi
    for singular_bash_guard__cand in /opt/homebrew/bin/bash /usr/local/bin/bash "$singular_bash_guard__path"; do
      if singular_bash_guard__probe "$singular_bash_guard__cand"; then
        export SINGULAR_BASH_BOOTSTRAPPED=1
        exec "$singular_bash_guard__cand" "$0" "$@"
      fi
    done
    singular_bash_guard__fail "no Bash >= 4 found (checked /opt/homebrew/bin/bash, /usr/local/bin/bash, PATH)"
  fi

  # Reached only when the pin was already honored: leave no residue behind.
  unset -f singular_bash_guard__fail singular_bash_guard__probe
  unset singular_bash_guard__path singular_bash_guard__cand 2>/dev/null || true
fi

SINGULAR_CLI_VERSION="0.1.0"

# One machine-install root for every CLI path. Export it because `setup` may
# install the selected checkout in a child process before an engine exists to
# source; that installer must resolve and create the same versions directory
# this process will verify immediately afterwards. A relative machine root
# would resolve differently after `cd` into a consumer, so reject it up front.
SINGULAR_HOME="${SINGULAR_HOME:-$HOME/.singular}"
if [[ "$SINGULAR_HOME" != /* ]]; then
  echo "singular: SINGULAR_HOME must be an absolute path: $SINGULAR_HOME" >&2
  exit 1
fi
export SINGULAR_HOME

die() { echo "singular: $*" >&2; exit 1; }

# Install one previously absent, consumer-owned copy from the immutable engine
# payload. Frozen installs deliberately make their own files read-only; those
# modes must not leak into files the operator is instructed to edit. Restrict
# normalization to the new destination, and never follow an existing (including
# dangling) symlink. Callers retain their command-specific existing-file policy.
copy_new_consumer_file() {
  local source="$1" destination="$2" access="${3:-editable}"
  [[ ! -e "$destination" && ! -L "$destination" ]] || return 1
  python3 - "$source" "$destination" "$access" <<'PY'
import os, shutil, stat, sys

source, destination, access = sys.argv[1:]
if access not in {"editable", "executable"}:
    raise SystemExit(f"unsupported consumer copy access: {access}")
mode = stat.S_IMODE(os.stat(source).st_mode) | stat.S_IWUSR
if access == "executable":
    mode |= stat.S_IXUSR
created = False
descriptor = -1
try:
    # O_EXCL refuses every pre-existing directory entry, including a dangling
    # symlink introduced between the shell precheck and this creation.
    descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    created = True
    with open(source, "rb") as reader, os.fdopen(descriptor, "wb") as writer:
        descriptor = -1
        shutil.copyfileobj(reader, writer)
        writer.flush()
        # Preserve the restrictions applied by the caller's umask. Only the
        # owner permissions required by the consumer contract are added back,
        # and they are applied to the inode created with O_EXCL while its
        # descriptor is still open. This does not make the parent directory or
        # the pathname cleanup below globally race-free.
        required = stat.S_IWUSR
        if access == "executable":
            required |= stat.S_IXUSR
        created_mode = stat.S_IMODE(os.fstat(writer.fileno()).st_mode)
        os.fchmod(writer.fileno(), created_mode | required)
except BaseException:
    if descriptor >= 0:
        os.close(descriptor)
    if created:
        try:
            os.unlink(destination)
        except FileNotFoundError:
            pass
    raise
PY
}

# Real directory of this script, following symlinks (for the installed launcher).
self_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -h "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null || true; }

# engineVersion from singular.config.json (fallback pin; empty if absent).
config_engine_version() {
  local root="$1"
  [[ -n "$root" && -f "$root/singular.config.json" ]] || return 0
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("engineVersion","") or "")' "$root/singular.config.json" 2>/dev/null || true
}

# schemaVersion from a repo's singular.config.json (empty if absent).
repo_schema_version() {
  local root="$1"
  [[ -n "$root" && -f "$root/singular.config.json" ]] || return 0
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("schemaVersion","") or "")' "$root/singular.config.json" 2>/dev/null || true
}

# The engine's schema contract version (empty if SCHEMA_VERSION is absent,
# e.g. an engine predating the file).
engine_schema_version() {
  local home="$1"
  [[ -n "$home" && -f "$home/SCHEMA_VERSION" ]] || return 0
  tr -d '[:space:]' < "$home/SCHEMA_VERSION"
}

# Rewrite schemaVersion in a repo's singular.config.json (migrate bookkeeping).
set_repo_schema_version() {
  python3 - "$1/singular.config.json" "$2" <<'PY'
import json, sys
path, ver = sys.argv[1], sys.argv[2]
with open(path) as f:
    cfg = json.load(f)
cfg["schemaVersion"] = ver
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
    f.write("\n")
PY
}

# Per-repo engine version pin: .singular-version file (authoritative), else
# engineVersion in singular.config.json. When both exist and disagree, warn —
# .singular-version still wins; resolution behavior is unchanged.
repo_pin() {
  local root="$1" pin="" cfg=""
  [[ -n "$root" ]] || return 0
  if [[ -f "$root/.singular-version" ]]; then
    pin="$(tr -d '[:space:]' < "$root/.singular-version")"
  fi
  cfg="$(config_engine_version "$root")"
  if [[ -n "$pin" && -n "$cfg" && "$pin" != "$cfg" ]]; then
    echo "singular: warning: .singular-version ($pin) and singular.config.json engineVersion ($cfg) disagree; using .singular-version" >&2
  fi
  [[ -n "$pin" ]] || pin="$cfg"
  printf '%s' "$pin"
}

# Resolve the engine install dir. Precedence:
#   1. $SINGULAR_ENGINE_HOME    (explicit override)
#   2. per-repo pin -> $SINGULAR_HOME/versions/<pin>
#   3. $SINGULAR_HOME/current   (default installed version)
#   4. dev fallback: this script's own ../  (running from a cloned engine repo)
resolve_engine_home() {
  if [[ -n "${SINGULAR_ENGINE_HOME:-}" ]]; then
    [[ -f "$SINGULAR_ENGINE_HOME/engine/lib.sh" ]] || die "SINGULAR_ENGINE_HOME has no engine/lib.sh: $SINGULAR_ENGINE_HOME"
    printf '%s' "$SINGULAR_ENGINE_HOME"; return
  fi
  local root pin; root="$(repo_root)"; pin="$(repo_pin "$root")"
  if [[ -n "$pin" ]]; then
    [[ -d "$SINGULAR_HOME/versions/$pin" ]] || die "repo pins engine $pin but it is not installed ($SINGULAR_HOME/versions/$pin). Run: singular update $pin"
    printf '%s' "$SINGULAR_HOME/versions/$pin"; return
  fi
  if [[ -d "$SINGULAR_HOME/current" ]]; then printf '%s' "$SINGULAR_HOME/current"; return; fi
  local sd; sd="$(self_dir)"
  if [[ -f "$sd/../engine/lib.sh" ]]; then (cd "$sd/.." && pwd); return; fi
  die "no engine found. Install with install.sh or set SINGULAR_ENGINE_HOME."
}

require_repo() {
  local root; root="$(repo_root)"
  [[ -n "$root" ]] || die "not inside a git repository (cd into your project first)"
  printf '%s' "$root"
}

# Exec an engine script with SINGULAR_ROOT bound to the current repo.
run_engine() {
  local script="$1"; shift
  local home root bash_bin="${SINGULAR_BASH_BIN:-bash}"; home="$(resolve_engine_home)"; root="$(require_repo)"
  [[ -f "$home/engine/$script" ]] || die "engine $home has no engine/$script"
  SINGULAR_ROOT="$root" SINGULAR_ENGINE_HOME="$home" exec "$bash_bin" "$home/engine/$script" "$@"
}

cmd_version() {
  # NB: $( ... || true ) does NOT catch `die`'s exit under set -e; capture explicitly.
  local home; home="$(resolve_engine_home 2>/dev/null)" || home=""
  echo "singular CLI    $SINGULAR_CLI_VERSION"
  if [[ -n "$home" && -f "$home/VERSION" ]]; then
    echo "engine      $(cat "$home/VERSION")  ($home)"
  else
    echo "engine      (not resolved)"
  fi
  local root; root="$(repo_root)"
  [[ -n "$root" ]] && echo "repo        $root"
}

cmd_doctor_v1() {
  local home root bash_path
  home="$(resolve_engine_home)"
  root="$(repo_root)"
  bash_path="${BASH:-${SINGULAR_BASH_BIN:-bash}}"
  [[ -f "$home/engine/doctor.py" ]] \
    || die "engine $home has no structured doctor helper (engine/doctor.py)"
  exec python3 "$home/engine/doctor.py" \
    --engine-home "$home" \
    --repo-root "$root" \
    --bash "$bash_path" \
    --bash-version "$BASH_VERSION" \
    "$@"
}

manifest_usage() {
  cat <<'EOF'
Usage: singular manifest {gen|check|lint|bless} [options]

Generate and validate routing manifests with the pinned singular-brain producer:
  manifest gen   [--config PATH] [--scope NAME]...       write manifests + freshness sidecars
  manifest check [--config PATH] [--scope NAME]...       compare generated bytes; exit 1 when stale
  manifest lint  [--config PATH] [--scope NAME]...       validate source routing metadata
  manifest bless [--config PATH] [--scope NAME]... (--all | ENTRY...)
                                                          explicitly re-verify descriptions

Configuration is opt-in. --config PATH takes precedence and a relative PATH is
resolved from the invocation directory. Otherwise brainConfig is read from the
effective singular JSON configuration (including SINGULAR_JSON_CONFIG_FILE) and
resolved relative to that JSON file. The brain configuration remains the base
for its scope roots, generated outputs, and freshness sidecars. No cwd ancestor
search is performed.

`check` proves output consistency. A body-only source edit remains
description_unverified until `bless` explicitly records routing-description
review; deleting an established sidecar likewise requires explicit bless
recovery. check, lint, and doctor never generate or bless files.
EOF
}

cmd_manifest() {
  if [[ $# -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    manifest_usage
    return 0
  fi
  local home root cwd
  home="$(resolve_engine_home)"
  root="$(repo_root)"
  cwd="$(pwd -P)"
  [[ -f "$home/engine/brain_manifest.py" ]] \
    || die "engine $home has no engine/brain_manifest.py"
  exec python3 "$home/engine/brain_manifest.py" \
    --engine-home "$home" --repo-root "$root" --cwd "$cwd" -- "$@"
}

cmd_context() {
  local home root cwd bash_path
  home="$(resolve_engine_home)"
  root="$(repo_root)"
  cwd="$(pwd -P)"
  bash_path="${BASH:-${SINGULAR_BASH_BIN:-bash}}"
  [[ -f "$home/engine/context_cli.py" ]] \
    || die "engine $home has no engine/context_cli.py"
  SINGULAR_ROOT="$root" SINGULAR_ENGINE_HOME="$home" exec "$bash_path" -c '
    home="$1"; root="$2"; cwd="$3"; shift 3
    source "$home/engine/lib.sh" >/dev/null
    exec python3 "$home/engine/context_cli.py" \
      --engine-home "$home" --repo-root "$root" --cwd "$cwd" -- "$@"
  ' _ "$home" "$root" "$cwd" "$@"
}

cmd_memory() {
  local home root cwd
  home="$(resolve_engine_home)"
  root="$(require_repo)"
  cwd="$(pwd -P)"
  [[ -f "$home/engine/memory_service.py" ]] \
    || die "engine $home has no engine/memory_service.py"
  SINGULAR_ROOT="$root" SINGULAR_ENGINE_HOME="$home" \
    exec python3 "$home/engine/memory_service.py" \
      --engine-home "$home" --repo-root "$root" --cwd "$cwd" -- "$@"
}

cmd_review_policy() {
  local home root bash_path
  home="$(resolve_engine_home)"
  root="$(repo_root)"
  bash_path="${BASH:-${SINGULAR_BASH_BIN:-bash}}"
  [[ -f "$home/engine/review_policy.py" ]] \
    || die "engine $home has no engine/review_policy.py"
  SINGULAR_ROOT="$root" SINGULAR_ENGINE_HOME="$home" exec "$bash_path" -c '
    home="$1"; shift
    source "$home/engine/lib.sh" >/dev/null
    exec python3 "$home/engine/review_policy.py" "$@"
  ' _ "$home" "$@"
}

cmd_init() {
  local home root; home="$(resolve_engine_home)"; root="$(require_repo)"
  echo "singular init -> $root"
  # config
  if [[ -e "$root/singular.config.json" || -L "$root/singular.config.json" ]]; then
    echo "  skip  singular.config.json (exists)"
  else
    copy_new_consumer_file "$home/templates/singular.config.json" \
      "$root/singular.config.json"
    echo "  new   singular.config.json (edit: targetBranch, gateCommand, areas)"
  fi
  # orchestration skeleton
  mkdir -p "$root/docs/orchestration/"{prompts,tasks,areas,gates}
  if [[ -d "$home/templates/prompts" ]]; then
    local prompt prompt_destination
    for prompt in "$home/templates/prompts/"*.md; do
      [[ -f "$prompt" ]] || continue
      prompt_destination="$root/docs/orchestration/prompts/$(basename "$prompt")"
      if [[ ! -e "$prompt_destination" && ! -L "$prompt_destination" ]]; then
        copy_new_consumer_file "$prompt" "$prompt_destination"
      fi
    done
    echo "  new   docs/orchestration/prompts/ (skeletons — rewrite for your stack)"
  fi
  if [[ ! -f "$root/docs/orchestration/dag.v0.json" ]]; then
    cat > "$root/docs/orchestration/dag.v0.json" <<'EOF'
{
  "schema": "singular.orchestration.dag.v0",
  "layers": ["scaffold", "domain", "api"],
  "kinds": ["build", "test"],
  "nodes": [
    {"id": "M0.scaffold", "stage": "M0", "area": "core", "layer": "scaffold", "kind": "build", "dependsOn": [], "requiredCompletion": "scaffold_complete"}
  ]
}
EOF
    echo "  new   docs/orchestration/dag.v0.json (1 starter node — define your graph)"
  fi
  # Gate adapter. Nothing shipped one before, and nothing documented the
  # gate-observation sidecar either — so the only gates that existed in the wild
  # were bare commands, and the engine had to infer everything about a failure
  # from an exit code and a log.
  if [[ -f "$home/templates/gate-adapter.sh" \
      && ! -e "$root/docs/orchestration/gates/gate.sh" \
      && ! -L "$root/docs/orchestration/gates/gate.sh" ]]; then
    copy_new_consumer_file "$home/templates/gate-adapter.sh" \
      "$root/docs/orchestration/gates/gate.sh" executable
    echo "  new   docs/orchestration/gates/gate.sh (optional adapter — read the header)"
  fi
  SINGULAR_ROOT="$root" SINGULAR_ENGINE_HOME="$home" "${SINGULAR_BASH_BIN:-bash}" "$home/engine/scaffold.sh"
  # One line for what scaffold.sh actually did. There used to be a second line
  # claiming ".gitignore (...)" as a separate init step; init never touched
  # .gitignore — singular_ensure_repo_scaffold appends those entries — so the line
  # reported work by the wrong actor and would have kept printing "ok" even if
  # scaffold had stopped doing it.
  echo "  ok    docs/orchestration scaffold + schema mirrors + .gitignore entries (.singular-state/, .worktrees/, .singular-evidence/, .singular-cache/)"
  # version pin
  if [[ ! -e "$root/.singular-version" && ! -L "$root/.singular-version" ]]; then
    copy_new_consumer_file "$home/VERSION" "$root/.singular-version"
    echo "  new   .singular-version ($(cat "$home/VERSION"))"
  fi
  echo ""
  echo "Next: edit singular.config.json + docs/orchestration/dag.v0.json, then: singular doctor"
}

cmd_update() {
  local want="${1:-}" root; root="$(require_repo)"
  if [[ -z "$want" ]]; then
    [[ -L "$SINGULAR_HOME/current" || -d "$SINGULAR_HOME/current" ]] || die "no $SINGULAR_HOME/current; pass a version: singular update <version>"
    want="$(cat "$SINGULAR_HOME/current/VERSION" 2>/dev/null || true)"
    [[ -n "$want" ]] || die "could not read $SINGULAR_HOME/current/VERSION"
  fi
  [[ -d "$SINGULAR_HOME/versions/$want" || -n "${SINGULAR_ENGINE_HOME:-}" ]] \
    || echo "singular: warning: engine $want is not installed yet ($SINGULAR_HOME/versions/$want)" >&2
  [[ ! -L "$root/.singular-version" ]] \
    || die "refusing to overwrite symlink: $root/.singular-version"
  echo "$want" > "$root/.singular-version"
  echo "singular: pinned $root to engine $want (.singular-version)"
  # Schema drift check against the newly pinned engine (when resolvable).
  local ehome="${SINGULAR_ENGINE_HOME:-$SINGULAR_HOME/versions/$want}"
  local esv rsv
  esv="$(engine_schema_version "$ehome")"
  rsv="$(repo_schema_version "$root")"
  if [[ -n "$esv" && -n "$rsv" && "$rsv" != "$esv" ]]; then
    echo "singular: warning: repo schema $rsv differs from engine schema $esv — run: singular migrate" >&2
  fi
}

# Bring the repo's schemaVersion up to the engine's SCHEMA_VERSION by running
# the migrations/<from>-to-<to>.sh chain (see migrations/README.md).
#
# `--dry-run` answers "what would this do to my repository" WITHOUT touching it:
# it resolves the same chain, by the same discovery, and prints it. It runs no
# migration and writes no schemaVersion — the mutating path below is untouched.
cmd_migrate() {
  local dry_run=0
  if [[ "${1:-}" == "--dry-run" ]]; then dry_run=1; shift; fi
  local home root; home="$(resolve_engine_home)"; root="$(require_repo)"
  local esv rsv
  esv="$(engine_schema_version "$home")"
  [[ -n "$esv" ]] || die "engine $home has no SCHEMA_VERSION file (engine predates schema migrations)"
  [[ -f "$root/singular.config.json" ]] || die "no singular.config.json in $root (run: singular init)"
  rsv="$(repo_schema_version "$root")"
  [[ -n "$rsv" ]] || die "singular.config.json has no schemaVersion key; add \"schemaVersion\": \"$esv\" if this repo already matches the engine schema"
  if [[ "$rsv" == "$esv" ]]; then
    echo "singular migrate: repo schema $rsv matches engine schema — up to date, nothing to do"
    return 0
  fi
  if [[ "$dry_run" == "1" ]]; then
    echo "singular migrate --dry-run: repo schema $rsv -> engine schema $esv"
    local dry_steps=0 dry_script dry_next
    while [[ "$rsv" != "$esv" ]]; do
      dry_script="$(ls "$home/migrations/$rsv-to-"*.sh 2>/dev/null | sort | head -n1 || true)"
      [[ -n "$dry_script" && -f "$dry_script" ]] \
        || die "no migration found for $rsv -> $esv (looked for $home/migrations/$rsv-to-*.sh); see CHANGELOG.md"
      dry_next="$(basename "$dry_script" .sh)"; dry_next="${dry_next#*-to-}"
      echo "  would run: $(basename "$dry_script") ($rsv -> $dry_next)"
      rsv="$dry_next"
      dry_steps=$((dry_steps + 1))
      [[ "$dry_steps" -le 64 ]] || die "migration chain exceeded 64 steps without reaching $esv (cycle in migrations/?)"
    done
    echo "singular migrate --dry-run: $dry_steps step(s) would bring the repo to schema $rsv; nothing was changed"
    return 0
  fi
  echo "singular migrate: repo schema $rsv -> engine schema $esv"
  local steps=0 script next
  while [[ "$rsv" != "$esv" ]]; do
    script="$(ls "$home/migrations/$rsv-to-"*.sh 2>/dev/null | sort | head -n1 || true)"
    [[ -n "$script" && -f "$script" ]] \
      || die "no migration found for $rsv -> $esv (looked for $home/migrations/$rsv-to-*.sh); see CHANGELOG.md"
    next="$(basename "$script" .sh)"; next="${next#*-to-}"
    echo "  run   $(basename "$script") ($rsv -> $next)"
    "$BASH" "$script" "$root" || die "migration $(basename "$script") failed (repo left at schema $rsv)"
    set_repo_schema_version "$root" "$next" || die "migration ran but schemaVersion could not be updated in singular.config.json"
    rsv="$next"
    steps=$((steps + 1))
    [[ "$steps" -le 64 ]] || die "migration chain exceeded 64 steps without reaching $esv (cycle in migrations/?)"
  done
  echo "singular migrate: repo is now at schema $rsv"
}

# Read-only metrics: delegate into the integrated engine/ctx-metrics.sh
# extractor (singular_ctx_metrics_json). Adds no metric logic of its own —
# it only resolves the engine, sources the extractor, and forwards the runs
# dir + events file (flags override the SINGULAR_RUNS_DIR/SINGULAR_EVENTS_FILE
# env defaults). Fixture-scoped and side-effect free: missing/empty inputs
# fail safe to a zeroed metrics object; no repo or .singular-state is required.
cmd_metrics() {
  local runs_dir="${SINGULAR_RUNS_DIR:-}" events_file="${SINGULAR_EVENTS_FILE:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)        shift ;;  # JSON is the only output; accepted for clarity
      --runs-dir)    runs_dir="${2:-}"; shift 2 ;;
      --events-file) events_file="${2:-}"; shift 2 ;;
      *) die "metrics: unknown argument: $1 (usage: singular metrics [--json] [--runs-dir DIR] [--events-file FILE])" ;;
    esac
  done
  local home; home="$(resolve_engine_home)"
  [[ -f "$home/engine/ctx-metrics.sh" ]] || die "engine $home has no engine/ctx-metrics.sh"
  # shellcheck disable=SC1090
  source "$home/engine/ctx-metrics.sh"
  singular_ctx_metrics_json "$runs_dir" "$events_file"
}

# Context provenance graph: delegate into the integrated engine/ctx-graph*.sh
# projector/reader functions (auto-sourced by the ctx-loader block when the
# engine entrypoint runs; here we source the graph modules directly since the
# CLI never loads lib.sh). Adds NO projection logic of its own — it resolves the
# engine, sources the graph modules in the same sorted order as the ctx-loader,
# resolves sensible stateDir/graphDir defaults, and forwards to
# singular_graph_rebuild / singular_graph_sync / singular_graph_query_*. Reached
# only when SINGULAR_CTX_GRAPH=1 (the dispatch arm refuses otherwise, exactly as
# an unknown command did before this hook).
cmd_graph() {
  local sub="${1:-}"; shift || true
  local home; home="$(resolve_engine_home)"
  [[ -f "$home/engine/ctx-graph.sh" ]] || die "engine $home has no engine/ctx-graph.sh"
  local g
  for g in "$home"/engine/ctx-graph*.sh; do
    [[ -f "$g" ]] || continue
    # shellcheck disable=SC1090
    source "$g"
  done
  local state_default="${SINGULAR_STATE_DIR:-.singular-state}"
  local graph_default="${SINGULAR_CTX_GRAPH_DIR:-$state_default/graph}"
  case "$sub" in
    rebuild) singular_graph_rebuild "${1:-$state_default}" "${2:-$graph_default}" ;;
    sync)    singular_graph_sync    "${1:-$state_default}" "${2:-$graph_default}" ;;
    query)
      local reader="${1:-}"; shift || true
      case "$reader" in
        neighbors)           singular_graph_query_neighbors "$graph_default" "$@" ;;
        lineage)             singular_graph_query_lineage "$graph_default" "$@" ;;
        open-contradictions) singular_graph_query_open_contradictions "$graph_default" "$@" ;;
        *) die "graph query: unknown reader: ${reader:-(none)} (usage: singular graph query <neighbors|lineage|open-contradictions> [args])" ;;
      esac ;;
    *) die "graph: unknown subcommand: ${sub:-(none)} (usage: singular graph <rebuild|sync|query> [args])" ;;
  esac
}

