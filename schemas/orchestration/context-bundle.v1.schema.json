{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singular.local/schemas/context-bundle.v1.schema.json",
  "title": "Singular immutable context bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contractVersion", "status", "identity", "policy", "invocation", "prompt", "promptSha256", "provenance", "omissions", "budget", "limitations", "bundleId"],
  "properties": {
    "schema": {"const": "singular.context.bundle.v1"},
    "contractVersion": {"const": 1},
    "status": {"enum": ["ok", "disabled"]},
    "reason": {"type": "string", "minLength": 1},
    "identity": {"$ref": "#/$defs/identity"},
    "policy": {"$ref": "#/$defs/policy"},
    "invocation": {"$ref": "#/$defs/invocation"},
    "prompt": {"type": "string"},
    "promptSha256": {"$ref": "#/$defs/hash"},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "omissions": {"type": "array", "items": {"$ref": "#/$defs/omission"}},
    "envelope": {"$ref": "#/$defs/envelope"},
    "budget": {"$ref": "#/$defs/budget"},
    "limitations": {"type": "string", "minLength": 1},
    "bundleId": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "worktree", "revision", "role", "phase", "policyVersion", "retrievalVersion", "snapshotId"],
      "properties": {
        "projectId": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "phase": {"type": ["string", "null"]},
        "policyVersion": {"const": "singular.context.policy.v1"},
        "retrievalVersion": {"const": "exact-lexical.v1"},
        "snapshotId": {"$ref": "#/$defs/hash"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "configPath", "configSha256"],
      "properties": {
        "version": {"const": "singular.context.policy-binding.v1"},
        "configPath": {"type": "string", "minLength": 1},
        "configSha256": {"$ref": "#/$defs/hash"}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocationId", "campaignBinding", "workspace"],
      "properties": {
        "invocationId": {"type": ["string", "null"]},
        "campaignBinding": {"type": ["string", "null"]},
        "workspace": {"type": "string", "minLength": 1}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startByte", "endByte"],
      "properties": {
        "startByte": {"type": "integer", "minimum": 0},
        "endByte": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["ref", "kind", "sourceLocation", "sourceSha256", "excerptSha256", "range", "reasons", "validity", "priority"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "kind": {"enum": ["task", "brain", "code", "run", "memory"]},
        "sourceLocation": {"type": "string", "minLength": 1},
        "sourceSha256": {"$ref": "#/$defs/hash"},
        "excerptSha256": {"$ref": "#/$defs/hash"},
        "range": {"$ref": "#/$defs/range"},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "validity": {"type": "string", "minLength": 1},
        "priority": {"enum": ["mandatory", "optional"]},
        "truncated": {"type": "boolean"},
        "provenance": {"type": "object"}
      }
    },
    "omission": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "reason"],
      "properties": {
        "ref": {"type": "string"}, "reason": {"type": "string"},
        "priority": {"enum": ["mandatory", "optional"]}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "limitBytes", "usedBytes", "remainingBytes", "mandatoryBytes", "optionalBytes", "estimator", "accountingBoundary", "providerVisibleBytes", "unknownComponents"],
      "properties": {
        "unit": {"const": "utf8-bytes"},
        "limitBytes": {"type": "integer", "minimum": 0},
        "usedBytes": {"type": "integer", "minimum": 0},
        "remainingBytes": {"type": "integer", "minimum": 0},
        "mandatoryBytes": {"type": "integer", "minimum": 0},
        "optionalBytes": {"type": "integer", "minimum": 0},
        "estimator": {"const": "utf8-exact.v1"},
        "accountingBoundary": {"const": "host-invocation"},
        "providerVisibleBytes": {"type": ["integer", "null"], "minimum": 0},
        "unknownComponents": {"type": "array", "items": {"type": "string"}},
        "accounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mandatoryTaskPolicyBytes", "requiredEvidenceBytes", "optionalSelectedBytes", "visibleHistoryBytes", "toolSkillContentBytes", "providerSystemBytes"],
          "properties": {
            "mandatoryTaskPolicyBytes": {"type": "integer", "minimum": 0},
            "requiredEvidenceBytes": {"type": "integer", "minimum": 0},
            "optionalSelectedBytes": {"type": "integer", "minimum": 0},
            "visibleHistoryBytes": {"type": ["integer", "null"], "minimum": 0},
            "toolSkillContentBytes": {"type": ["integer", "null"], "minimum": 0},
            "providerSystemBytes": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "outputReserve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "conversion", "reservedBytes", "appliedToByteLimit", "enforcement"],
          "properties": {
            "requested": {"type": ["object", "null"]},
            "conversion": {"type": ["object", "null"]},
            "reservedBytes": {"type": ["integer", "null"], "minimum": 0},
            "appliedToByteLimit": {"type": "boolean"},
            "enforcement": {"type": "string", "minLength": 1}
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostManagedExactBytes", "providerObservableBytes", "coverage", "overlapRule", "tokenizer", "estimatorIdentity", "cumulativeUsageNote"],
          "properties": {
            "hostManagedExactBytes": {"type": "integer", "minimum": 0},
            "providerObservableBytes": {"type": ["integer", "null"], "minimum": 0},
            "coverage": {"type": "string", "minLength": 1},
            "overlapRule": {"type": "string", "minLength": 1},
            "tokenizer": {"type": ["string", "null"]},
            "estimatorIdentity": {"const": "utf8-exact.v1"},
            "cumulativeUsageNote": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "taskContractSha256", "role", "phase", "runId", "attemptId", "sessionId", "candidateRevision", "worktree", "requestedModel", "effectiveModel", "providerName", "providerExecutable", "providerBuild", "capabilityProfile", "policyVersion", "policySha256", "sourceVersions", "sourceVersionsSha256", "campaignBinding", "bundleSnapshotId", "unknownBindings", "strict"],
      "properties": {
        "version": {"const": "singular.context.envelope.v1"},
        "taskContractSha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 1},
        "phase": {"type": ["string", "null"]},
        "runId": {"type": ["string", "null"]},
        "attemptId": {"type": ["string", "null"]},
        "sessionId": {"type": ["string", "null"]},
        "candidateRevision": {"type": ["string", "null"]},
        "worktree": {"type": ["string", "null"]},
        "requestedModel": {"type": ["string", "null"]},
        "effectiveModel": {"type": ["string", "null"]},
        "providerName": {"type": ["string", "null"]},
        "providerExecutable": {"type": ["string", "null"]},
        "providerBuild": {"type": ["string", "null"]},
        "capabilityProfile": {"type": ["string", "null"]},
        "policyVersion": {"const": "singular.context.policy.v1"},
        "policySha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "sourceVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "sha256", "validity"],
            "properties": {
              "ref": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/hash"},
              "validity": {"type": "string", "minLength": 1}
            }
          }
        },
        "sourceVersionsSha256": {"$ref": "#/$defs/hash"},
        "campaignBinding": {"type": ["string", "null"]},
        "bundleSnapshotId": {"type": ["string", "null"]},
        "unknownBindings": {"type": "array", "items": {"type": "string"}},
        "strict": {"type": "boolean"}
      }
    }
  }
}
